        </mxCell>
        <mxCell id="a1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" value="Atlas&#xa;POST /commerce/purchase&#xa;status: pending_slip" vertex="1">
          <mxGeometry x="410" y="120" width="158" height="72" as="geometry" />
        </mxCell>
        <mxCell id="a2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" value="Atlas&#xa;POST /commerce/slip&#xa;expected_name + amount" vertex="1">
          <mxGeometry x="410" y="220" width="158" height="72" as="geometry" />
        </mxCell>
        <mxCell id="v1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;" value="Google Vision&#xa;DOCUMENT_TEXT_DETECTION" vertex="1">
          <mxGeometry x="608" y="120" width="150" height="72" as="geometry" />
