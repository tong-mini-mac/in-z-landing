        <!-- Main flow -->
        <mxCell id="c1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;" value="Customer&#xa;Select plan&#xa;Bank transfer" vertex="1">
