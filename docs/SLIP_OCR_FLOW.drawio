        <mxCell id="db" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#F5F5F5;strokeColor=#666666;" value="payment_slips&#xa;file + ocr_json&#xa;activity: slip_upload" vertex="1">
          <mxGeometry x="798" y="168" width="120" height="72" as="geometry" />
