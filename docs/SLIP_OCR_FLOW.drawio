          <mxGeometry x="48" y="24" width="480" height="32" as="geometry" />
        </mxCell>
        <mxCell id="sub" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=12;fontColor=#666666;" value="Atlas = Automated Tax, Ledger &amp; Audit System  ·  OCR assists review (no auto-approve)  ·  PDF skips OCR but slip is still stored" vertex="1">
