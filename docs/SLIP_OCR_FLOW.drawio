        <mxCell id="l1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontStyle=1;" value="Landing&#xa;POST /api/pay/transfer&#xa;CheckoutView" vertex="1">
