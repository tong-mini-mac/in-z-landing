        <mxCell id="l2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" value="Landing&#xa;formatSlipOcrLines()&#xa;notifySecretarySlip()" vertex="1">
