        </mxCell>
        <mxCell id="c2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" value="Customer&#xa;Upload slip&#xa;JPG / PNG / WEBP" vertex="1">
