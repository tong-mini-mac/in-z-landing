        <mxCell id="p1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;" value="bank_slip_parser&#xa;payer · amount · ref&#xa;name_match · amount_match" vertex="1">
          <mxGeometry x="608" y="220" width="150" height="72" as="geometry" />
