# Public site URL (used in activation links)
NEXT_PUBLIC_SITE_URL=https://www.inz.lol

# Required in production — signs activation tokens
AUTH_ACTIVATION_SECRET=replace-with-a-long-random-secret

# --- Mail provider: choose ONE ---

# Option A: Resend (recommended on Vercel)
# Verify domain inz.lol in Resend, then allow sending from:
#   no-reply@inz.lol  info@inz.lol  help@inz.lol
RESEND_API_KEY=

# Option B: SMTP (Gmail / Google Workspace / host SMTP)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your-account@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=IN Z <no-reply@inz.lol>

# Mailboxes used by the app:
#   no-reply@inz.lol  — Sign Up activation emails (From)
#   info@inz.lol      — Customer Service inbox (To) + activation Reply-To
#   help@inz.lol      — Support inbox (To)

# Special trial login via ERP (complimentary product access, no revenue)
# ERP_BASE_URL=https://erp-atlas-production.up.railway.app
# ERP_SPECIAL_LOGIN_KEY=same-as-erp-service-key

# Shared secret for Landing → product SSO handoff (must match product INZ_SSO_SECRET)
# INZ_SSO_SECRET=replace-with-long-random-secret
# SYNTHCOMM_URL=https://synthcomm-production.up.railway.app
# UNIVERSAL_SIMULATOR_URL=https://qa-lab-production.up.railway.app
# MUSIC_DEMO_URL=https://myclaw-music-demo-production.up.railway.app
# CONTENT_CREATOR_URL=https://podcast-web-production-41ac.up.railway.app
